{
  "name": "errhive-cars",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "validate:data": "node scripts/validate-data.mjs",
    "build": "npm run validate:data && astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "audit": "node scripts/audit.mjs",
    "verify": "npm run check && npm run build && npm test && npm run audit",
    "audit:performance": "node scripts/performance-audit.mjs",
    "test:browser": "playwright test",
    "reports": "npm run articles:check && node scripts/write-reports.mjs && node scripts/write-manuscript-index.mjs",
    "article:coverage": "node scripts/article-coverage.mjs",
    "article:target": "node scripts/article-coverage.mjs --require-target",
    "articles:check": "node scripts/check-written-articles.mjs",
    "articles:complete": "node scripts/check-written-articles.mjs --require-complete"
  },
  "dependencies": {
    "astro": "7.4.2",
    "@astrojs/markdown-satteri": "0.4.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "linkedom": "0.18.14",
    "lighthouse": "13.6.0",
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
