  "findings": [
    {
      "severity": "blocking",
      "kind": "evidence_gap",
      "finding": "All dictionary records are definitions-only. A title cannot establish actual causes, symptoms, test order, threshold, pin identity, component location or repair on an unspecified vehicle.",
      "requiredAction": "Acquire per-code or explicitly scoped per-family OEM monitor/service evidence before representing generated prose as researched diagnostics."
    },
    {
      "severity": "blocking",
      "kind": "manufacturer_definition_collision",
      "finding": "One unscoped manufacturer definition is not stable across model years/modules. GM official2006 monitor data uses P1684 for a TCM power-up thermistor condition; repository Chevrolet label says Driver5Line4, while Pontiac discovery currently resolves to the Chrysler-style battery-disconnection label. This is a demonstrated insufficiency of a brand-only mapping, not a claim that every historical label is false.",
      "sourceUrl": "https://gsi.ext.gm.com/gmspo/mode6/pdf/2006/2006trans1_b%20.pdf",
      "requiredAction": "Preserve distinct year/module meanings with exact application scope; audit cross-corporate labels independently."
    },
    {
      "severity": "blocking",
      "kind": "fault_subtype_omitted",
      "finding": "Some brief base-code labels lack a fault subtype. SAE J2012 describes failure-type subcodes for three-byte DTCs. U3000 Control Module and B0001 deployment-control labels must not automatically produce one specific electrical or replacement diagnosis.",
      "sourceUrl": "https://saemobilus.sae.org/standards/j2012_201303-diagnostic-trouble-code-definitions",
      "requiredAction": "Require full scanner display and matching OEM module context before publishing a subtype-specific path."
    },
    {
      "severity": "high",
      "kind": "near_duplicate_risk",
      "finding": "7354 records collapse into2113 multi-entry lexical families when only bank/cylinder/channel slots are normalized. A generator that changes these slots in the same text will reproduce the user complaint.",
      "requiredAction": "A separate article needs the actual channel/cylinder location, distinctions and evidence, not just different slot text."
    },
    {
      "severity": "high",
      "kind": "search_intent_unverified",
      "finding": "The corpus contains9891 powertrain,1228 network,478 chassis and189 body entries, including many modern hybrid/charger channels. Code existence is not search demand or real fleet prevalence.",
      "requiredAction": "Do not label all10000 as most-searched codes without actual search data."
    },
    {
      "severity": "informational",
      "kind": "syntax_not_semantics",
      "finding": "No malformed five-character code or duplicate canonical ID was found in this audit. That only confirms syntax/identity; it does not validate the meanings against current SAE/OEM sources."
    }
  ],
