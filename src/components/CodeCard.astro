---
import {codePath,getMake,systems,type CodeEntry} from '../lib/cars';
interface Props {entry:CodeEntry;compact?:boolean;}
const {entry,compact=false}=Astro.props;
const makeNames=(entry.makeIds?.length?entry.makeIds:[entry.makeId]).map(id=>getMake(id).name);
const makeLabel=entry.scope==='generic'?'Generic OBD-II':makeNames.length>2?`${makeNames.slice(0,2).join(' / ')} +${makeNames.length-2}`:makeNames.join(' / ');
const system=systems.find(s=>s.id===entry.system);
---
<a class:list={['dtc-card',{'compact':compact}]} href={codePath(entry)} data-code-id={entry.id} data-make-ids={(entry.makeIds?.length?entry.makeIds:[entry.makeId]).join(' ')}>
 <div class="dtc-card-top"><span title={makeNames.join(', ')}>{makeLabel}</span><span class="card-arrow" aria-hidden="true">↗</span></div>
 <div class="dtc-card-body"><span class="dtc-number">{entry.code}</span><h3>{entry.title}</h3></div>
 <div class="dtc-card-foot"><span><span class="system-dot" aria-hidden="true"></span>{system?.name||entry.system}</span><span>Read the code <span aria-hidden="true">→</span></span></div>
</a>
