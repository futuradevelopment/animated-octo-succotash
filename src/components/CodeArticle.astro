---
import Base from '../layouts/Base.astro';
import CodeCard from './CodeCard.astro';
import {getMake,getSource,getRelatedCodes,makePath,systemPath,systems,site,codePath,type CodeEntry} from '../lib/cars';
import {guidesForCode,guidePath,guideMakes} from '../lib/authored-guides';
import {manuscriptForEntry,renderManuscript} from '../lib/code-manuscripts';
interface Props {entry:CodeEntry;}
const {entry}=Astro.props;
const make=getMake(entry.makeId);
const makeIds=entry.makeIds?.length?entry.makeIds:[entry.makeId];
const definitionSource=getSource(entry.sourceId);
const system=systems.find(item=>item.id===entry.system);
const related=getRelatedCodes(entry,6);
const reviewedGuides=guidesForCode(entry.code).filter(guide=>entry.scope==='generic'||guideMakes(guide).some(id=>makeIds.includes(id)));
const scopeLabel=entry.scope==='generic'?'Generic OBD-II':makeIds.map(id=>getMake(id).name).join(' / ');
const referenceLabel=entry.scope==='generic'?'OBD-II':makeIds.length>1?'Shared manufacturer':make.name;
const manuscript=manuscriptForEntry(entry.id);
const rendered=manuscript?await renderManuscript(manuscript):undefined;
const title=manuscript?.title||`${referenceLabel} ${entry.code}: ${entry.title}`;
const definitionDescription=`${referenceLabel} ${entry.code} definition: ${entry.title}. Read the source and scope of this dictionary entry.`;
const description=manuscript?.description||definitionDescription;
const schema:Record<string,unknown>[]=[{'@context':'https://schema.org','@type':'DefinedTerm',name:entry.title,termCode:entry.code,description:definitionDescription,url:site.url+codePath(entry),inDefinedTermSet:{'@type':'DefinedTermSet',name:`${scopeLabel} code reference`,url:site.url+makePath(make.id)}}];
if(manuscript)schema.push({'@context':'https://schema.org','@type':'TechArticle',headline:manuscript.title,description:manuscript.description,url:site.url+codePath(entry),mainEntityOfPage:site.url+codePath(entry),citation:manuscript.sources.map(source=>source.url),about:{'@type':'DefinedTerm',termCode:entry.code,name:entry.title},inLanguage:'en-US'});
---
<Base title={title} description={description} kind={manuscript?'article':'website'} noindex={entry.status==='published_noindex'} breadcrumbs={[{label:'Home',href:'/'},{label:'Makes',href:'/makes/'},{label:make.name,href:makePath(make.id)},{label:entry.code}]} schema={schema}>
 <article data-reference-kind={manuscript?'diagnostic-article':'dictionary'} data-code-manuscript={manuscript?.entryId} data-source-review={manuscript?.sourceReview}>
  <header class="container diagnostic-heading">
   <div class="diagnostic-title"><p class="eyebrow">{manuscript?'Diagnostic article':'Code dictionary'} <span aria-hidden="true">/</span> {scopeLabel}</p><h1>{manuscript?manuscript.title:<><span class="article-code">{entry.code}</span><span data-code-definition>{entry.title}</span></>}</h1><p class="lede" data-reference-limit>{manuscript?manuscript.description:'This is a definition, not a repair instruction. It does not identify a failed part or establish that a vehicle is safe to drive.'}</p><div class="article-tags"><a href={systemPath(entry.system)} class="badge">{system?.name||entry.system} <span aria-hidden="true">↗</span></a><span class="badge provenance-badge">{manuscript?'Source-scoped explanation':definitionSource.kind==='dataset'?'Community code reference':definitionSource.kind==='manufacturer'?'Manufacturer reference':'Public agency reference'}</span></div></div>
   <aside class="code-context"><p class="eyebrow">Reference details</p><dl><div><dt>Code</dt><dd>{entry.code}</dd></div><div><dt>System</dt><dd>{system?.name||entry.system}</dd></div><div><dt>Definition source</dt><dd>{definitionSource.publisher}</dd></div></dl><a href="#sources">Open the source <span aria-hidden="true">↗</span></a></aside>
  </header>
  <div class="container reference-body">
   {manuscript&&rendered&&<>
    <section class="manuscript-scope" aria-labelledby="manuscript-scope-title"><p class="eyebrow">Read before applying this article</p><h2 id="manuscript-scope-title">Documented application</h2><p data-manuscript-scope>{manuscript.scope}</p><p>The code alone does not identify a failed part or establish that a vehicle is safe to drive. Confirm the vehicle, reporting module and applicable service procedure.</p></section>
    {manuscript.sourceReview==='needs-review'&&<aside class="notice warning manuscript-review" data-source-review-note><strong>Source details need further review</strong><p>The article identifies unresolved wording or data in the cited documentation. Treat those points as unconfirmed until they are checked against the applicable vehicle service information. This is not an independently certified repair procedure.</p></aside>}
    <nav class="manuscript-contents" aria-label="In this article">{rendered.headings.filter(heading=>heading.depth===2).map(heading=><a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>
    <div class="prose manuscript-prose" data-manuscript-body set:html={rendered.html}/>
    <section class="manuscript-sources" aria-labelledby="manuscript-source-title"><h2 id="manuscript-source-title">Article source documents</h2><ol class="source-list">{manuscript.sources.map(source=><li><p class="source-meta">{source.publisher}</p><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} <span aria-hidden="true">↗</span></a></li>)}</ol><p class="source-status">Source checks describe how the text was prepared; they do not certify a diagnosis or confirm compatibility with every vehicle using this code.</p></section>
    <section class="dictionary-definition" aria-labelledby="dictionary-definition-title"><p class="eyebrow">Original code reference</p><h2 id="dictionary-definition-title">Dictionary definition</h2><p data-code-definition>{entry.title}</p><p>This definition retains its original catalog scope. The article above is limited to its explicitly documented application.</p></section>
   </>}
   <section id="applicability" class="applicability-panel"><h2>Reference scope</h2><p class="applicability-makes">{entry.scope==='generic'?'Generic OBD-II definition.':<>The source associates this definition with {makeIds.map((id,i)=><>{i>0?', ':''}<a href={makePath(id)}>{getMake(id).name}</a></>)}.</>}</p><p>A manufacturer label does not establish the model, year, engine or module to which a diagnosis applies. <a href="/safety/">Read the safety and diagnostic limits</a>.</p></section>
   {reviewedGuides.length>0&&<section id="reviewed-guides" class="section"><div class="section-head"><div><p class="eyebrow">Separately researched</p><h2>Vehicle-specific diagnosis</h2></div></div><p class="reference-guide-intro">These guides address the exact vehicles and conditions in their sources. Select the guide that matches your vehicle.</p><div class="code-grid">{reviewedGuides.map(guide=><a class="notice" data-authored-guide={guide.id} href={guidePath(guide)}><p class="eyebrow">{guideMakes(guide).map(id=>getMake(id).name).join(' / ')}</p><h3>{guide.title}</h3><p>{guide.description}</p></a>)}</div></section>}
   <section id="sources" class="sources-block"><div class="section-head"><h2>Definition source</h2></div><ol class="source-list"><li><div class="source-meta"><span class="source-kind">{definitionSource.kind==='dataset'?'Community reference data':definitionSource.kind==='manufacturer'?'Manufacturer documentation':'Public agency reference'}</span><span>{definitionSource.publisher}</span></div><a href={definitionSource.url} target="_blank" rel="noopener noreferrer">{definitionSource.title} <span aria-hidden="true">↗</span></a><p>Source checked <time datetime={definitionSource.checkedOn}>{definitionSource.checkedOn}</time>{definitionSource.license&&<> · {definitionSource.license}</>}</p></li></ol></section>
   <aside id="report" class="reference-feedback"><h2>{manuscript?'Report an article or definition issue':'Report a definition issue'}</h2><p>Include this page, the exact scanner display and the source that supports a correction.</p><a class="text-link" href="/contact/">Correction details <span aria-hidden="true">↗</span></a></aside>
  </div>
  {related.length>0&&<section class="container related-section"><div class="section-head"><h2>Other dictionary entries</h2><a class="text-link" href={makePath(make.id)}>Browse {make.name} <span aria-hidden="true">↗</span></a></div><div class="code-grid">{related.map(item=><CodeCard entry={item} compact/>)}</div></section>}
 </article>
</Base>
<style>
.reference-body{max-width:1000px}.reference-body .applicability-panel{margin-top:0}.reference-body .applicability-panel p+p{margin-top:14px}.reference-guide-intro{margin-bottom:24px}.reference-body .code-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.reference-body .notice h3{font-size:23px;line-height:1.25;margin:12px 0}.reference-body .notice .eyebrow{font-size:10px}.reference-body .reference-feedback h2{font-size:24px}.reference-body .sources-block{margin-top:36px}@media(max-width:700px){.reference-body .code-grid{grid-template-columns:1fr}}
.manuscript-scope{padding:26px 30px;background:var(--teal-soft);border-top:3px solid var(--teal);margin-bottom:24px}.manuscript-scope .eyebrow{font-size:9px;margin-bottom:12px}.manuscript-scope h2,.manuscript-sources h2,.dictionary-definition h2{font-size:27px;line-height:1.25;margin-bottom:16px}.manuscript-scope p:not(.eyebrow){font-size:14px;line-height:1.85}.manuscript-scope p+p{margin-top:14px}.manuscript-scope p:last-child{font-size:12px;color:var(--muted)}.manuscript-review{margin-bottom:24px}.manuscript-contents{display:flex;flex-wrap:wrap;gap:12px 25px;border-block:1px solid var(--line);padding:20px 0;margin-bottom:28px;font-size:12px;line-height:1.7}.manuscript-contents a{color:var(--orange)}.manuscript-prose{max-width:850px;overflow-wrap:anywhere}.manuscript-prose :global(h2),.manuscript-prose :global(h3){scroll-margin-top:24px}.manuscript-prose :global(table){width:100%;border-collapse:collapse;margin-block:20px;font-size:13px;line-height:1.7}.manuscript-prose :global(th),.manuscript-prose :global(td){padding:12px;border:1px solid var(--line);text-align:left;overflow-wrap:anywhere}.manuscript-sources{border-top:1px solid var(--line);padding-top:28px;margin-top:30px}.source-status{font-size:12px;line-height:1.8;color:var(--muted);margin-block:16px 30px}.dictionary-definition{padding:25px 28px;border:1px solid var(--line);background:var(--white);margin-bottom:26px}.dictionary-definition .eyebrow{font-size:9px;margin-bottom:12px}.dictionary-definition p{font-size:14px;line-height:1.8}.dictionary-definition p:last-child{font-size:12px;color:var(--muted);margin-top:12px}@media(max-width:700px){.manuscript-scope,.dictionary-definition{padding:22px}.manuscript-contents{display:grid;gap:10px}.manuscript-prose :global(table){display:block;overflow-x:auto}.manuscript-scope h2,.manuscript-sources h2,.dictionary-definition h2{font-size:25px}}
</style>
