---
import Base from '../layouts/Base.astro';
import CodeCard from './CodeCard.astro';
import {getMake,getSource,getRelatedCodes,makePath,systemPath,systems,site,codePath,type CodeEntry} from '../lib/cars';
import {guidesForCode,guidePath,guideMakes} from '../lib/authored-guides';
interface Props {entry:CodeEntry;}
const {entry}=Astro.props;
const make=getMake(entry.makeId);
const makeIds=entry.makeIds?.length?entry.makeIds:[entry.makeId];
const definitionSource=getSource(entry.sourceId);
const system=systems.find(item=>item.id===entry.system);
const related=getRelatedCodes(entry,6);
const reviewedGuides=guidesForCode(entry.code).filter(guide=>entry.scope==='generic'||guideMakes(guide).some(id=>makeIds.includes(id)));
const scopeLabel=entry.scope==='generic'?'Generic OBD-II':makeIds.map(id=>getMake(id).name).join(' / ');
const referenceLabel=entry.scope==='generic'?'OBD-II':makeIds.length>1?'Shared manufacturer':make.name;
const title=`${referenceLabel} ${entry.code}: ${entry.title}`;
const description=`${referenceLabel} ${entry.code} definition: ${entry.title}. Read the source and scope of this dictionary entry.`;
const schema=[{'@context':'https://schema.org','@type':'DefinedTerm',name:entry.title,termCode:entry.code,description,url:site.url+codePath(entry),inDefinedTermSet:{'@type':'DefinedTermSet',name:`${scopeLabel} code reference`,url:site.url+makePath(make.id)}}];
---
<Base title={title} description={description} noindex={entry.status==='published_noindex'} breadcrumbs={[{label:'Home',href:'/'},{label:'Makes',href:'/makes/'},{label:make.name,href:makePath(make.id)},{label:entry.code}]} schema={schema}>
 <article data-reference-kind="dictionary">
  <header class="container diagnostic-heading">
   <div class="diagnostic-title"><p class="eyebrow">Code dictionary <span aria-hidden="true">/</span> {scopeLabel}</p><h1><span class="article-code">{entry.code}</span><span data-code-definition>{entry.title}</span></h1><p class="lede" data-reference-limit>This is a definition, not a repair instruction. It does not identify a failed part or establish that a vehicle is safe to drive.</p><div class="article-tags"><a href={systemPath(entry.system)} class="badge">{system?.name||entry.system} <span aria-hidden="true">↗</span></a><span class="badge provenance-badge">{definitionSource.kind==='dataset'?'Community code reference':definitionSource.kind==='manufacturer'?'Manufacturer reference':'Public agency reference'}</span></div></div>
   <aside class="code-context"><p class="eyebrow">Reference details</p><dl><div><dt>Code</dt><dd>{entry.code}</dd></div><div><dt>System</dt><dd>{system?.name||entry.system}</dd></div><div><dt>Definition source</dt><dd>{definitionSource.publisher}</dd></div></dl><a href="#sources">Open the source <span aria-hidden="true">↗</span></a></aside>
  </header>
  <div class="container reference-body">
   <section id="applicability" class="applicability-panel"><h2>Reference scope</h2><p class="applicability-makes">{entry.scope==='generic'?'Generic OBD-II definition.':<>The source associates this definition with {makeIds.map((id,i)=><>{i>0?', ':''}<a href={makePath(id)}>{getMake(id).name}</a></>)}.</>}</p><p>A manufacturer label does not establish the model, year, engine or module to which a diagnosis applies. <a href="/safety/">Read the safety and diagnostic limits</a>.</p></section>
   {reviewedGuides.length>0&&<section id="reviewed-guides" class="section"><div class="section-head"><div><p class="eyebrow">Separately researched</p><h2>Vehicle-specific diagnosis</h2></div></div><p class="reference-guide-intro">These guides address the exact vehicles and conditions in their sources. Select the guide that matches your vehicle.</p><div class="code-grid">{reviewedGuides.map(guide=><a class="notice" data-authored-guide={guide.id} href={guidePath(guide)}><p class="eyebrow">{guideMakes(guide).map(id=>getMake(id).name).join(' / ')}</p><h3>{guide.title}</h3><p>{guide.description}</p></a>)}</div></section>}
   <section id="sources" class="sources-block"><div class="section-head"><h2>Definition source</h2></div><ol class="source-list"><li><div class="source-meta"><span class="source-kind">{definitionSource.kind==='dataset'?'Community reference data':definitionSource.kind==='manufacturer'?'Manufacturer documentation':'Public agency reference'}</span><span>{definitionSource.publisher}</span></div><a href={definitionSource.url} target="_blank" rel="noopener noreferrer">{definitionSource.title} <span aria-hidden="true">↗</span></a><p>Source checked <time datetime={definitionSource.checkedOn}>{definitionSource.checkedOn}</time>{definitionSource.license&&<> · {definitionSource.license}</>}</p></li></ol></section>
   <aside id="report" class="reference-feedback"><h2>Report a definition issue</h2><p>Include this page, the exact scanner display and the source that supports a correction.</p><a class="text-link" href="/contact/">Correction details <span aria-hidden="true">↗</span></a></aside>
  </div>
  {related.length>0&&<section class="container related-section"><div class="section-head"><h2>Other dictionary entries</h2><a class="text-link" href={makePath(make.id)}>Browse {make.name} <span aria-hidden="true">↗</span></a></div><div class="code-grid">{related.map(item=><CodeCard entry={item} compact/>)}</div></section>}
 </article>
</Base>
<style>
.reference-body{max-width:1000px}.reference-body .applicability-panel{margin-top:0}.reference-body .applicability-panel p+p{margin-top:14px}.reference-guide-intro{margin-bottom:24px}.reference-body .code-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.reference-body .notice h3{font-size:23px;line-height:1.25;margin:12px 0}.reference-body .notice .eyebrow{font-size:10px}.reference-body .reference-feedback h2{font-size:24px}.reference-body .sources-block{margin-top:36px}@media(max-width:700px){.reference-body .code-grid{grid-template-columns:1fr}}
</style>
