---
import Base from '../layouts/Base.astro';
import CarArtwork from '../components/CarArtwork.astro';
import CodeCard from '../components/CodeCard.astro';
import {featuredCodes,makes,models,systems,statistics,codePath,makePath,modelPath,systemPath,getMake,getSource,codesForMake} from '../lib/cars';
const featured=featuredCodes.slice(0,6);
const sample=featured.find(entry=>entry.code==='P0300')||featured[0];
const preferredMakes=['ford','chevrolet','toyota','honda','nissan','jeep','hyundai','kia','bmw','subaru','gmc','volkswagen'];
const availableMakes=makes.filter(make=>!['generic','obd-ii','obd2'].includes(make.id)&&codesForMake(make.id).length>0);
const visibleMakes=[...preferredMakes.flatMap(id=>availableMakes.filter(make=>make.id===id)),...availableMakes.filter(make=>!preferredMakes.includes(make.id))].slice(0,12);
const fmt=(n:number)=>n.toLocaleString('en-US');
---
<Base title="ErrHive Cars — Check Engine. Clear Head." description="Understand diagnostic trouble codes with clear definitions, source context and sensible next steps. Search OBD-II codes or start with your vehicle make and model.">
 <section class="home-hero container">
  <div class="hero-copy"><p class="hero-eyebrow"><span aria-hidden="true"></span>The automotive diagnostic field guide</p><h1>Check engine.<br/><em>Clear head.</em></h1><p class="hero-description">A few characters on a scanner.<br/>A better understanding of what comes next.</p>
   <form class="hero-search" action="/search/" method="get" role="search"><label for="home-query">What code are you seeing?</label><div class="hero-search-field"><svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input id="home-query" name="q" type="search" placeholder="Code, make or symptom" required/><button type="submit" aria-label="Find a diagnostic trouble code"><span>Find code</span><span aria-hidden="true">↗</span></button></div></form>
   <div class="quick-codes"><span>Explore a reference</span>{featured.slice(0,3).map(entry=><a href={codePath(entry)}>{entry.code}<span aria-hidden="true">↗</span></a>)}</div>
   <p class="hero-footnote">Reference first. Diagnosis next.</p>
  </div>
  <div class="scanner-panel">
   <div class="scanner-topline"><span class="scanner-indicator" aria-hidden="true"></span><span>DIAGNOSTIC REFERENCE</span><span class="scanner-protocol">OBD-II</span></div>
   {sample&&<><div class="scanner-readout"><div><p>EXAMPLE TROUBLE CODE</p><a href={codePath(sample)} class="scanner-code">{sample.code}<svg viewBox="0 0 24 24" width="29" height="29" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div><svg class="engine-light" viewBox="0 0 48 42" width="48" height="42" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6h17v5h7v5h5v18h-6v-5l-5 7H12l-5-7V16h8ZM2 18v11M20 1h10M25 1v5"/><path d="m26 15-5 9h9l-5 8"/></svg></div><p class="scanner-definition">{sample.title}</p></>}
   <div class="scanner-vehicle"><CarArtwork/></div>
   <div class="scanner-bottomline"><div><span class="scanner-caption">SOURCE CONTEXT</span><p>{sample&&getSource(sample.sourceId).kind==='dataset'?'Community code reference':'Documented code reference'}</p></div><a href={sample?codePath(sample):'/search/'}>Read the reference <span aria-hidden="true">↗</span></a></div>
   <div class="scanner-corner corner-tl" aria-hidden="true"></div><div class="scanner-corner corner-br" aria-hidden="true"></div>
  </div>
 </section>
 <div class="reference-strip"><div class="container reference-strip-inner"><p><strong>{fmt(statistics.codes)}</strong><span>code references</span></p><p><strong>{fmt(statistics.manufacturers)}</strong><span>vehicle makes</span></p><p><strong>{fmt(statistics.models)}</strong><span>model guides</span></p><a href="/sources/">Every reference has a source.<span>See how the guide is built <span aria-hidden="true">↗</span></span></a></div></div>
 <section class="container section makes-section"><div class="section-head"><div><p class="eyebrow">01 / Your vehicle, your context</p><h2>Start with your make.</h2></div><a class="text-link" href="/makes/">All vehicle makes <span aria-hidden="true">↗</span></a></div><div class="make-grid">{visibleMakes.map(make=><a class="make-tile" href={makePath(make.id)}><span class="make-monogram" aria-hidden="true">{make.name.slice(0,1)}</span><span>{make.name}</span><span class="make-arrow" aria-hidden="true">↗</span></a>)}</div><p class="section-footnote">Make labels help you find a reference. Year, engine and model documentation determine whether it applies.</p></section>
 <section class="container section featured-section"><div class="section-head"><div><p class="eyebrow">02 / From the code library</p><h2>Small code.<br class="mobile-only"/> Useful context.</h2></div><a class="text-link" href="/search/">Open the code finder <span aria-hidden="true">↗</span></a></div><div class="code-grid">{featured.map(entry=><CodeCard entry={entry}/>)}</div></section>
 <section class="systems-section"><div class="container systems-inner"><div class="systems-intro"><p class="eyebrow">Read the first letter</p><h2>Four systems.<br/>A place to begin.</h2><p>A code’s prefix puts the signal in context. Explore the reference by vehicle system.</p></div><div class="system-grid">{systems.map(system=><a class="system-tile" href={systemPath(system.id)}><span class="system-letter">{system.letter}</span><div><h3>{system.name}</h3><p>{system.description}</p></div><span aria-hidden="true">↗</span></a>)}</div></div></section>
 {models.length>0&&<section class="container section models-section"><div class="section-head"><div><p class="eyebrow">03 / More than a make badge</p><h2>Bring your vehicle into focus.</h2></div><a class="text-link" href="/models/">Explore model guides <span aria-hidden="true">↗</span></a></div><div class="model-preview-grid">{models.slice(0,3).map(model=><a href={modelPath(model)} class="model-preview"><div class="model-preview-top"><span class="eyebrow">{getMake(model.makeId).name}</span><span aria-hidden="true">↗</span></div><h3>{model.name}</h3><p class="model-years">{model.years}</p><p class="model-summary">{model.summary}</p><span class="model-preview-footer">Model scope & documented context <span aria-hidden="true">→</span></span></a>)}</div></section>}
 <section class="container reading-room"><div class="reading-room-heading"><p class="eyebrow">Good diagnosis starts with good questions</p><h2>Read the code.<br/><em>Keep the context.</em></h2><p>The name of a fault is not proof of a failed part. Use the reference to understand the signal, then build the evidence.</p><a class="button" href="/guides/">Into the field guides <span aria-hidden="true">↗</span></a></div><div class="reading-room-steps"><div><span>01</span><div><h3>Capture the full picture.</h3><p>Keep the exact code, scan report, symptoms and vehicle details together.</p></div></div><div><span>02</span><div><h3>Know what the source supports.</h3><p>Code-definition data and a manufacturer’s model-specific guidance answer different questions.</p></div></div><div><span>03</span><div><h3>Choose an informed next step.</h3><p>Start with the documented checks. Understand the limits before buying a part or clearing a code.</p></div></div></div></section>
</Base>
