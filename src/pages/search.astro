---
import Base from '../layouts/Base.astro';
import {activeMakes,codesForMake} from '../lib/cars';
---
<Base title="Search automotive diagnostic codes" description="Look up an exact scanner code or search the code reference by manufacturer and wording." noindex breadcrumbs={[{label:'Home',href:'/'},{label:'Search'}]}>
<div class="container"><header class="page-head"><p class="eyebrow">THE CODE FINDER</p><h1>What did the scanner say?</h1><p class="lede">Paste the complete display, including codes such as P0300 or P0A80. Preserve any module name and suffix for the vehicle-specific check.</p></header>
<form id="code-search" role="search" action="/search/" method="get"><label class="field-label" for="query">Code, scanner text, or definition wording</label><div class="search-row"><input class="search-input" id="query" name="q" type="search" maxlength="250" placeholder="e.g. P0A80 or P0300 stored" autocomplete="off"/><button class="button" type="submit">Find reference</button></div><div class="search-filters"><div><label class="field-label" for="make">Manufacturer reference</label><select class="search-input" id="make" name="make"><option value="">Choose a make, or enter an exact code</option>{activeMakes.map(make=><option value={make.id}>{make.name}{codesForMake(make.id).length===0?' — model documents':''}</option>)}</select></div><button class="button button-secondary" type="button" id="clear-search">Clear search</button></div></form>
<div class="notice"><p>A reference match does not verify model, year, engine or module applicability. Shared manufacturer labels retain one canonical reference. Generic definitions are listed separately.</p></div><section class="section" aria-labelledby="results-title"><div class="section-head"><h2 id="results-title">Matching references</h2><p id="search-status" role="status" aria-live="polite">Enter a code or choose a manufacturer to begin.</p></div><div id="search-hint" class="notice" hidden></div><ol id="search-results" class="search-results"></ol><div id="search-empty" class="empty-state" hidden><h3>No matching reference.</h3><p>Check every character and the reporting module. We do not create a definition for an unknown display. A generic reference, where available, still needs a vehicle-specific check.</p><a href="/makes/">Browse manufacturer references</a></div><div id="search-error" class="notice" hidden><p>The search data could not load. Try again, or use the <a href="/codes/">code directory</a>.</p></div></section><noscript><p class="notice">Search filtering requires JavaScript. All published references remain readable through the <a href="/codes/">paginated code directory</a>.</p></noscript></div>
</Base>
<script>
type Entry={id:string;code:string;title:string;url:string;makeId:string;makeIds:string[];system:string;text?:string};
type Manifest={version:number;codes:Record<string,string[]>;parts:Record<string,{url:string;makeIds:string[]}>;makes:{id:string;name:string;count:number;url:string}[]};
const form=document.querySelector<HTMLFormElement>('#code-search')!,input=document.querySelector<HTMLInputElement>('#query')!,make=document.querySelector<HTMLSelectElement>('#make')!,results=document.querySelector<HTMLOListElement>('#search-results')!,status=document.querySelector<HTMLElement>('#search-status')!,empty=document.querySelector<HTMLElement>('#search-empty')!,error=document.querySelector<HTMLElement>('#search-error')!,hint=document.querySelector<HTMLElement>('#search-hint')!;
let manifestPromise:Promise<Manifest>|undefined,revision=0;
const parts=new Map<string,Promise<Entry[]>>();
const normal=(value:string)=>value.toLowerCase().replace(/[^a-z0-9]+/g,' ').trim();
const parse=(value:string)=>[...new Set([...value.matchAll(/(?:^|[^A-Z0-9])([PBCU][0-3][0-9A-F]{3})(?:[:-][0-9A-F]{2})?(?=$|[^A-Z0-9])/gi)].map(match=>match[1].toUpperCase()))];
function element<K extends keyof HTMLElementTagNameMap>(tag:K,text:string,className=''){const node=document.createElement(tag);node.textContent=text;if(className)node.className=className;return node;}
async function json(url:string){const response=await fetch(url,{credentials:'same-origin'});if(!response.ok)throw new Error('Search data unavailable');return response.json();}
function manifest():Promise<Manifest>{if(!manifestPromise)manifestPromise=json('/search-data/index.json').catch(reason=>{manifestPromise=undefined;throw reason});return manifestPromise!;}
function loadPart(id:string,index:Manifest){if(!parts.has(id))parts.set(id,json(index.parts[id].url).then((rows:Entry[])=>rows.filter(row=>typeof row.code==='string'&&row.url.startsWith('/')&&!row.url.startsWith('//')).map(row=>({...row,text:normal(`${row.code} ${row.title} ${row.makeIds.join(' ')} ${row.system}`)}))).catch(reason=>{parts.delete(id);throw reason}));return parts.get(id)!;}
function saveUrl(){const params=new URLSearchParams();if(input.value.trim())params.set('q',input.value.trim());if(make.value)params.set('make',make.value);history.replaceState(null,'',`/search/${params.size?'?'+params.toString():''}`);}
function suggestMakes(index:Manifest,partIds:string[],query:string){hint.hidden=false;hint.replaceChildren(element('p','This display occurs in several reference groups. Choose the manufacturer label to narrow the lookup.'));const list=document.createElement('ul');for(const id of new Set(partIds.flatMap(part=>index.parts[part].makeIds))){const item=index.makes.find(make=>make.id===id);if(!item)continue;const li=document.createElement('li'),link=element('a',item.name);link.href=`/search/?q=${encodeURIComponent(query)}&make=${encodeURIComponent(id)}`;li.append(link);list.append(li);}hint.append(list);}
async function search(){const request=++revision,query=input.value.trim(),selectedMake=make.value;results.replaceChildren();empty.hidden=true;error.hidden=true;hint.hidden=true;hint.replaceChildren();if(!query&&!selectedMake){status.textContent='Enter a code or choose a manufacturer to begin.';results.removeAttribute('aria-busy');return;}status.textContent='Finding matching references…';results.setAttribute('aria-busy','true');try{
 const index=await manifest();if(request!==revision)return;const target=selectedMake?index.makes.find(item=>item.id===selectedMake):undefined;
 if(target?.count===0){status.textContent=`${target.name} manufacturer documents are available.`;hint.hidden=false;const link=element('a',`Browse ${target.name} documented code cases`);link.href=`/makes/${target.id}/`;hint.append(element('p','These model documents carry their own code, year and powertrain scope. Choose Generic OBD-II separately for generic definitions.'),link);return;}
 const exact=parse(query);let partIds:string[]=[];let initialPage=false;
 if(exact.length){partIds=[...new Set(exact.flatMap(code=>index.codes[code]||[]))].filter(id=>!selectedMake||index.parts[id].makeIds.includes(selectedMake));if(!selectedMake&&partIds.length>8){suggestMakes(index,partIds,query);status.textContent='Choose a manufacturer to search these reference groups.';return;}}
 else if(selectedMake){if(target){const directory=await json(target.url);partIds=directory.parts.map((part:{id:string})=>part.id);if(!query){partIds=partIds.slice(0,1);initialPage=true;}}}
 else {status.textContent='Choose a manufacturer for a wording search, or enter a complete code such as P0A80.';hint.hidden=false;hint.append(element('p','Wording searches stay within your chosen manufacturer reference. This avoids downloading the entire library.'));return;}
 const records:Entry[]=[];for(let offset=0;offset<partIds.length;offset+=4){const chunk=await Promise.all(partIds.slice(offset,offset+4).map(id=>loadPart(id,index)));if(request!==revision)return;records.push(...chunk.flat());}
 const terms=normal(query).split(' ').filter(Boolean);const matches=[...new Map(records.filter(row=>(!selectedMake||row.makeIds.includes(selectedMake))&&(exact.length?exact.includes(row.code):terms.every(term=>row.text!.includes(term)))).map(row=>[row.id,row])).values()].sort((a,b)=>(exact.indexOf(a.code)<0?999:exact.indexOf(a.code))-(exact.indexOf(b.code)<0?999:exact.indexOf(b.code))||(a.makeId==='generic'?-1:0)-(b.makeId==='generic'?-1:0)||a.code.localeCompare(b.code)||a.title.localeCompare(b.title));
 for(const row of matches.slice(0,60)){const li=element('li','','search-result');const badge=element('span',row.code,'result-code');const body=document.createElement('div');const heading=document.createElement('h3'),link=element('a',row.title);link.href=row.url;link.dataset.codeId=row.id;link.dataset.code=row.code;link.dataset.makeIds=row.makeIds.join(' ');heading.append(link);body.append(element('p',row.makeIds.map(id=>index.makes.find(item=>item.id===id)?.name||id).join(' · '),'eyebrow'),heading,element('p',`${row.system} · ${row.makeId==='generic'?'Generic reference':'Manufacturer-labelled reference'}`));li.append(badge,body);results.append(li);}
 empty.hidden=matches.length>0;status.textContent=matches.length?`${matches.length}${initialPage?' in the first reference group':''} match${matches.length===1?'':'es'}${matches.length>60?' · Showing 60; narrow your search.':'.'}`:'No matching reference for these details.';
 if(initialPage){hint.hidden=false;const directory=element('a','Browse every reference for this make');directory.href=`/makes/${selectedMake}/`;hint.append(element('p','Enter a code or wording to search beyond the first group.'),directory);}
 if(exact.length&&/[:-][0-9a-f]{2}/i.test(query)){hint.hidden=false;hint.append(element('p','The base code was searched. Keep the scanner suffix and module name: this index does not verify their vehicle-specific interpretation.'));}
 }catch{if(request!==revision)return;status.textContent='Search is temporarily unavailable.';error.hidden=false;}finally{if(request===revision)results.removeAttribute('aria-busy');}}
let timer:ReturnType<typeof setTimeout>;input.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(()=>{saveUrl();search();},250)});make.addEventListener('change',()=>{clearTimeout(timer);saveUrl();search();});form.addEventListener('submit',event=>{event.preventDefault();clearTimeout(timer);saveUrl();search();});document.querySelector('#clear-search')!.addEventListener('click',()=>{clearTimeout(timer);input.value='';make.value='';saveUrl();search();input.focus();});const parameters=new URLSearchParams(location.search);input.value=(parameters.get('q')||'').slice(0,250);const selected=parameters.get('make')||'';if([...make.options].some(option=>option.value===selected))make.value=selected;if(input.value||make.value)search();
</script>
<style>
.search-row,.search-filters{display:flex;gap:14px;align-items:end}.search-row .search-input{flex:1;min-width:0}.search-filters{margin:18px 0 26px}.search-filters>div{flex:1}.search-results{padding:0;list-style:none;display:grid;gap:14px}.search-results :global(.search-result){display:grid;grid-template-columns:90px 1fr;gap:22px;padding:24px;border:1px solid var(--line,#d8dce2);border-radius:14px}.search-results :global(.result-code){font:700 20px monospace;padding:15px 8px;background:#17252d;color:#fff;border-radius:9px;height:fit-content;text-align:center}.search-results :global(h3){font-size:20px;margin:8px 0}.search-results :global(p){margin:6px 0}.search-results :global(a){color:inherit}.search-results :global(.eyebrow){line-height:1.5}[hidden]{display:none!important}@media(max-width:600px){.search-row,.search-filters{align-items:stretch;flex-direction:column}.search-results :global(.search-result){grid-template-columns:68px 1fr;padding:17px;gap:15px}.search-results :global(.result-code){font-size:15px}.search-results :global(h3){font-size:18px}}
</style>
