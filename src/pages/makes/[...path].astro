---
import Base from '../../layouts/Base.astro';
import MakeDirectory from '../../components/MakeDirectory.astro';
import {makeDirectoryPages,modelsForMake,modelPath,bulletinsForMake,getSource} from '../../lib/cars';
import type {DirectoryPage} from '../../lib/cars';
export function getStaticPaths(){return makeDirectoryPages.map(pageData=>({params:{path:`${pageData.make!.id}${pageData.page>1?`/page/${pageData.page}`:''}`},props:{pageData}}));}
const {pageData}=Astro.props as {pageData:DirectoryPage};const make=pageData.make!;const suffix=pageData.page>1?` — Page ${pageData.page}`:'';const modelList=pageData.page===1?modelsForMake(make.id):[];const documentationOnly=pageData.total===0;const makeCases=pageData.page===1?bulletinsForMake(make.id).filter(item=>documentationOnly||!item.modelIds.length):[];
---
<Base title={`${make.name} diagnostic code references${suffix}`} description={`Browse ${make.name} code references and source-supported vehicle context${suffix}.`} breadcrumbs={[{label:'Home',href:'/'},{label:'Makes',href:'/makes/'},{label:make.name}]}>
 <header class="container page-head"><p class="eyebrow">MANUFACTURER REFERENCE</p><h1>{make.name} code references{suffix}.</h1><p class="lede">{documentationOnly?'Explore documented code cases for the models, years and powertrains identified by the manufacturer.':'Read the source definition and confirm the exact vehicle, reporting module and diagnostic procedure.'}</p></header>
 {!documentationOnly&&<MakeDirectory {...pageData}/>}
 {documentationOnly&&<div class="container notice"><p>These manufacturer documents cover specific vehicle conditions. Keep the complete scanner display and match the stated model, year and powertrain before using a case.</p><a href="/makes/generic/">Browse the separate generic OBD-II reference</a></div>}
 {modelList.length>0&&<section id="model-documentation" class="container section"><div class="section-head"><h2>Model documentation</h2><p>Only models identified by the cited manufacturer material are listed.</p></div><div class="code-grid">{modelList.map(model=><a class="notice" href={modelPath(model)}><h3>{model.name}</h3><p>{model.years}</p></a>)}</div></section>}
 {makeCases.length>0&&<section id="documented-cases" class="container section prose"><h2>{documentationOnly?'Documented code cases':'Other manufacturer documentation'}</h2><p>Each document retains its own vehicle scope and complete code displays.</p>{makeCases.map(item=><section class="notice" data-bulletin-id={item.id}><h3>{item.title}</h3><p>{item.summary}</p><p><strong>Documented scope:</strong> {item.years}{item.engine?` · ${item.engine}`:''}</p>{item.codes.length>0&&<p><strong>Displays:</strong> {item.codes.join(', ')}</p>}<p>{item.action}</p><p>{item.limitations}</p>{item.guideSlug&&<p><a class="text-link" href={`/guides/${item.guideSlug}/`}>Read the diagnostic case guide <span aria-hidden="true">→</span></a></p>}{item.modelIds.length>0&&<ul aria-label="Models in this document">{modelList.filter(model=>item.modelIds.includes(model.id)).map(model=><li><a href={modelPath(model)}>{make.name} {model.name}</a></li>)}</ul>}<ul aria-label="Manufacturer sources">{item.sourceIds.map(id=><li><a href={getSource(id).url} target="_blank" rel="noopener noreferrer">{getSource(id).title}</a></li>)}</ul></section>)}</section>}
</Base>
