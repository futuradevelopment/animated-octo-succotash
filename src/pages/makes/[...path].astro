---
import Base from '../../layouts/Base.astro';
import MakeDirectory from '../../components/MakeDirectory.astro';
import {makeDirectoryPages,modelsForMake,modelPath,bulletinsForMake,getSource,codesForMake} from '../../lib/cars';
import type {DirectoryPage} from '../../lib/cars';
export function getStaticPaths(){return makeDirectoryPages.map(pageData=>({params:{path:`${pageData.make!.id}${pageData.page>1?`/page/${pageData.page}`:''}`},props:{pageData}}));}
const {pageData}=Astro.props as {pageData:DirectoryPage};const make=pageData.make!;const suffix=pageData.page>1?` — Page ${pageData.page}`:'';const modelList=pageData.page===1?modelsForMake(make.id):[];const makeCases=pageData.page===1?bulletinsForMake(make.id).filter(item=>!item.modelIds.length):[];
---
<Base title={`${make.name} diagnostic code references${suffix}`} description={`Browse ${make.name} code references and source-supported vehicle context${suffix}.`} breadcrumbs={[{label:'Home',href:'/'},{label:'Makes',href:'/makes/'},{label:make.name}]}><header class="container page-head"><p class="eyebrow">MANUFACTURER REFERENCE</p><h1>{make.name} code references{suffix}.</h1><p class="lede">Read the source definition and confirm the exact vehicle, reporting module and diagnostic procedure.</p></header><MakeDirectory {...pageData}/>{modelList.length>0&&<section class="container section"><div class="section-head"><h2>Model documentation</h2><p>Only models identified by the cited manufacturer material are listed.</p></div><div class="code-grid">{modelList.map(model=><a class="notice" href={modelPath(model)}><h3>{model.name}</h3><p>{model.years}</p></a>)}</div></section>}{pageData.total===0&&<div class="container notice"><p>No manufacturer-specific code entries are published for this make. The model documents below retain their own scope.</p>{codesForMake('generic').length>0&&<a href="/makes/generic/">Browse the separate generic code reference</a>}</div>}{makeCases.length>0&&<section class="container section prose"><h2>Other manufacturer documentation</h2><p>These documents have the scope stated below. They are not attached to every vehicle model.</p>{makeCases.map(item=><section class="notice"><h3>{item.title}</h3><p>{item.summary}</p><p><strong>Documented scope:</strong> {item.years}{item.engine?` · ${item.engine}`:''}</p>{item.codes.length>0&&<p><strong>Displays:</strong> {item.codes.join(', ')}</p>}<p>{item.action}</p><p>{item.limitations}</p><ul>{item.sourceIds.map(id=><li><a href={getSource(id).url} target="_blank" rel="noopener noreferrer">{getSource(id).title}</a></li>)}</ul></section>)}</section>}</Base>
