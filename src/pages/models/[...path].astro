---
import Base from '../../layouts/Base.astro';
import {models,getMake,getSource,makePath,bulletinsForModel} from '../../lib/cars';
import type {VehicleModel} from '../../lib/cars';
export function getStaticPaths(){return models.map(model=>({params:{path:`${model.makeId}/${model.slug}`},props:{model}}));}
const {model}=Astro.props as {model:VehicleModel};const make=getMake(model.makeId);const cases=bulletinsForModel(model.id);const evidence=[...new Set([...model.sourceIds,...cases.flatMap(item=>item.sourceIds)])].map(getSource);
---
<Base title={`${make.name} ${model.name}: documentation and diagnostic context`} description={`${make.name} ${model.name}: ${model.summary}`} breadcrumbs={[{label:'Home',href:'/'},{label:'Makes',href:'/makes/'},{label:make.name,href:makePath(make.id)},{label:model.name}]}><article class="container prose-page"><header class="page-head"><p class="eyebrow">MANUFACTURER DOCUMENTATION</p><h1>{make.name} {model.name}</h1><p class="lede">{model.summary}</p><p>Documented years: {model.years}</p></header><div class="notice"><p>Match the document’s model, years, engine, market and other conditions. This page does not establish every code the vehicle can display.</p></div><section class="section prose"><h2>Documented cases</h2>{cases.length?cases.map(item=><section class="notice"><h3>{item.title}</h3><p>{item.summary}</p><p><strong>Scope:</strong> {item.years}{item.engine?` · ${item.engine}`:''}</p>{item.codes.length>0&&<p><strong>Displays in the document:</strong> {item.codes.join(', ')}</p>}<p>{item.action}</p><p>{item.limitations}</p><ul>{item.sourceIds.map(id=><li><a href={getSource(id).url} target="_blank" rel="noopener noreferrer">{getSource(id).title}</a></li>)}</ul></section>):<p>No code-specific case has been attached to this model. Use the source below for the documented scope.</p>}</section><section id="sources" class="section"><h2>Sources and scope</h2><ol class="source-list">{evidence.map(source=><li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a><p>{source.publisher} · Checked {source.checkedOn}</p></li>)}</ol></section><p><a href="/search/">Search a scanner code</a> · <a href={makePath(make.id)}>Return to {make.name}</a></p></article></Base>
