---
import Base from '../layouts/Base.astro';
const pages:Record<string,{title:string;description:string;intro:string;sections:{title:string;body:string}[]}>= {
 about:{title:'About ErrHive Cars',description:'How ErrHive Cars presents automotive diagnostic references and documented vehicle context.',intro:'ErrHive Cars helps you read a scanner result, find the cited definition, and prepare for the next informed check.',sections:[{title:'What the library contains',body:'The code directory includes attributed reference definitions. Selected manufacturer documents add limited model or diagnostic context. The source label tells you which kind of evidence supports each page.'},{title:'What a matching code establishes',body:'A matching display locates a reference. It does not establish a failed part, a repair cost, or compatibility with every vehicle carrying a manufacturer badge.'},{title:'Independent publishing',body:'ErrHive Cars is independent of vehicle manufacturers. Manufacturer names identify the context of a reference and do not imply approval or affiliation.'}]},
 'editorial-policy':{title:'Editorial policy',description:'Publication standards for code definitions, manufacturer scope and model documentation.',intro:'A useful code page must distinguish its reference definition from a diagnosis for an individual vehicle.',sections:[{title:'Source labels remain visible',body:'Community datasets are described as reference material. We do not label their entries as manufacturer-verified. Manufacturer documents are attributed separately, and their model, year, market and powertrain restrictions remain part of the guidance.'},{title:'One canonical reference',body:'Shared manufacturer labels can point to one definition page. Alternative spellings and manufacturer associations do not create extra repair articles. Exact-model pages require specific documentation; we do not multiply generic codes across models and years.'},{title:'No invented repairs',body:'A code alone cannot prove a component failure. We do not generate replacement instructions, repair prices, or supported vehicles from a code label. General preparation steps are identified separately from any source-supported diagnostic instructions.'},{title:'Corrections and conflicts',body:'When references conflict, the exact vehicle documentation takes priority. Preserve the complete code, source link and vehicle context when reporting a concern. An unresolved definition should not be presented as a universal instruction.'}]},
 'research-methodology':{title:'Research and reference methodology',description:'How definitions, source provenance and vehicle applicability are separated in ErrHive Cars.',intro:'The data model keeps a code definition, its source, and vehicle-specific evidence separate.',sections:[{title:'Reference provenance',body:'Each code entry identifies its source. Imported reference material retains its original provenance in the versioned dataset. A source link or a successful automated check is not proof that a technical claim applies to your vehicle.'},{title:'Vehicle context',body:'Model documentation is added only when a source identifies the vehicle or condition. Broad brand guidance is not silently attached to every model. Engine, year and market qualifications must be checked in the original document.'},{title:'Publication checks',body:'Automated checks look for unresolved references, duplicate routes, malformed codes, missing pages and broken internal links. Editorial source review is a separate task. Search and sitemap counts refer to published canonical records, not guessed vehicle-code combinations.'}]},
 safety:{title:'Safety before diagnosis',description:'How to use an automotive code reference without treating it as permission to continue driving or attempt a repair.',intro:'The warning on the vehicle and its owner manual take priority over a code-reference page.',sections:[{title:'Assess the situation first',body:'A code definition cannot establish whether a vehicle is safe to drive. Follow urgent warnings and seek appropriate roadside or professional help when the condition is unsafe or unclear. Do not use a lookup result to dismiss braking, steering, overheating, smoke, or other serious symptoms.'},{title:'Preserve evidence',body:'Keep the complete scan report and note the vehicle, reporting module, warning, symptoms and circumstances. Clearing a code removes information; it does not establish that the cause has been corrected.'},{title:'Respect the repair boundary',body:'Use the exact manufacturer procedure and appropriate qualifications for any testing or repair. Airbags, high-voltage systems, fuel systems, lifting equipment and moving components are not suitable for improvised checks based on a reference label.'}]},
 privacy:{title:'Privacy information',description:'Information about the current static ErrHive Cars website and its browser search.',intro:'The current site provides public reference pages without accounts or a comment system.',sections:[{title:'Browser search',body:'Search filters run in your browser after downloading static reference files. A submitted search can appear in the page URL and browser history. Do not put personal details or a vehicle identification number in the search field.'},{title:'Hosting and third-party links',body:'The hosting provider may process ordinary request information to deliver and secure the website. External manufacturer and reference links lead to separate websites with their own policies.'},{title:'Site features',body:'The current implementation does not include advertising scripts, a customer database, or an analytics integration. This information should be revised if those features are introduced.'}]},
 terms:{title:'Terms of use',description:'Scope and limitations of the ErrHive Cars reference library.',intro:'Use the site as an independent reference alongside the documentation for your exact vehicle.',sections:[{title:'Reference scope',body:'Definitions and preparation guidance do not replace a manufacturer diagnostic procedure or a qualified inspection. Availability of a code in the library does not establish applicability, completeness, or a particular repair outcome.'},{title:'Source material',body:'Third-party reference material retains its stated attribution and license. Manufacturer names and documents belong to their respective owners. See the source list for the origin of the material used on the site.'},{title:'Changes',body:'Published definitions and source notes can change as evidence is reviewed. Check the current source and vehicle instructions before relying on an older saved copy.'}]},
 contact:{title:'Contact and corrections',description:'What to include when identifying a problem in an ErrHive Cars reference.',intro:'A public contact channel has not been configured for this project yet.',sections:[{title:'Useful correction details',body:'Keep the page URL, exact code, cited source, and a concise explanation of the possible error. Vehicle-specific claims need the relevant manufacturer document and its scope.'},{title:'Vehicle assistance',body:'For immediate vehicle support, use the manufacturer, your repair provider, or an appropriate roadside service. This reference website does not provide live mechanical diagnosis.'}]}
};
export function getStaticPaths(){return ['about','editorial-policy','research-methodology','safety','privacy','terms','contact'].map(info=>({params:{info}}));}
const key=Astro.params.info!;const page=pages[key];
---
<Base title={page.title} description={page.description} breadcrumbs={[{label:'Home',href:'/'},{label:page.title}]}><article class="container prose-page"><header class="page-head"><p class="eyebrow">ERRHIVE CARS</p><h1>{page.title}</h1><p class="lede">{page.intro}</p></header><div class="prose">{page.sections.map(section=><section><h2>{section.title}</h2><p>{section.body}</p></section>)}<p><a href="/sources/">View reference sources</a> · <a href="/editorial-policy/">Editorial policy</a> · <a href="/search/">Search a code</a></p></div></article></Base>
